{
  "name": "xpost-x-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Drives X's web composer in headless Chromium for xpost on Linux",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "oxlint src test",
    "fmt": "oxfmt --check .",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.33.0"
}
